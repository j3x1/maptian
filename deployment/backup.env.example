# Credentials and settings for backup-to-tigris.sh.
#
# Copy this to /root/ghost-config/backup.env ON THE SERVER and fill it in.
# It holds secrets, so the script refuses to run unless it is mode 600:
#
#   chmod 600 /root/ghost-config/backup.env
#
# Never commit the filled-in version.

# --- required --------------------------------------------------------------

BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Tigris endpoint -------------------------------------------------------

# Paste whatever the Tigris console shows. This is the current global endpoint.
BACKUP_S3_ENDPOINT=https://t3.storage.dev

# Tigris ignores the region but the S3 protocol requires a non-empty one.
BACKUP_S3_REGION=auto

# --- layout and retention --------------------------------------------------

# Key prefix inside the bucket. Normalised to no leading slash and exactly one
# trailing slash. Set it to empty (nothing after the =) for no prefix, which is
# what a bucket dedicated to this blog wants.
BACKUP_S3_PREFIX=ghost/

# How many daily snapshots to keep. Weeklies are NEVER pruned, and the image
# mirror is never deleted from. Minimum 2.
BACKUP_RETENTION_DAYS=7

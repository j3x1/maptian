# PER-SITE backup config -> /root/ghost-config/backup.chaijiaxun.env
#
# Loaded after backup.env and wins over it. No secrets here, but keep it 600
# for consistency with the shared file.

# Docker volume holding this blog's content.
GHOST_VOLUME=ghost_content

# Container to stop/start during a restore. Backups do not need it -- they use
# sqlite3 .backup and never take the blog down.
GHOST_CONTAINER=ghost-blog

# Key prefix inside the bucket. Defaults to "<site>/" if unset. Explicit here
# so the two blogs can never end up sharing a prefix.
BACKUP_S3_PREFIX=chaijiaxun/

# SHARED backup config -> /root/ghost-config/backup.env
#
# Credentials and bucket, shared by every site. Per-site settings live in
# backup.<site>.env alongside this file.
#
# The scripts refuse to run unless this is mode 600, because it holds secrets:
#
#   chmod 600 /root/ghost-config/backup.env
#
# Never commit the filled-in version.

# --- required --------------------------------------------------------------

BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Tigris endpoint -------------------------------------------------------

# Paste whatever the Tigris console shows. This is the current global endpoint.
BACKUP_S3_ENDPOINT=https://t3.storage.dev

# Tigris ignores the region but the S3 protocol requires a non-empty one.
BACKUP_S3_REGION=auto

# --- defaults (a site file can override these) -----------------------------

# How many daily snapshots to keep. Weeklies are NEVER pruned and the image
# mirror is never deleted from. Minimum 2.
BACKUP_RETENTION_DAYS=7
